node_modules/

# Rebuilt by `bun run snapshot`; large and stale within hours.
data/*.db
data/*.db-shm
data/*.db-wal

# Generated meal plans and the approved snack list; regenerated each run.
data/plan.json
data/plan.md
data/snacks.json

# Leftovers carried between shops; rewritten by every plan.
data/carryover.json

# Personal usage data: taste, ratings and past recipes. Kept local so it never
# goes public and never causes pull conflicts. Persistence comes from the file
# on disk; a single-machine tool has no need to version-control it.
data/blocklist.json
data/dislikes.json
data/history.json
