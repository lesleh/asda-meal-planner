# Rebuilt by `bun run snapshot`; large and stale within hours.
data/*.db
data/*.db-shm
data/*.db-wal

# Generated meal plans and the approved snack list; regenerated each run.
data/plan.json
data/snacks.json

# Recipe history and the snack blocklist cannot be regenerated (they are
# hand-curated), so they are tracked rather than ignored.
!data/history.json
!data/blocklist.json
