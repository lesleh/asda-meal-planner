node_modules/

# Rebuilt by `bun run snapshot`; large and stale within hours.
data/*.db
data/*.db-shm
data/*.db-wal

# Generated meal plans and the approved snack list; regenerated each run.
data/plan.json
data/plan.md
data/snacks.json

# Leftovers carried between shops; rewritten by every plan.
data/carryover.json

# The snack blocklist is personal taste; kept local so it never goes public
# and never causes pull conflicts.
data/blocklist.json

# Recipe history cannot be regenerated (it is hand-curated), so it is tracked.
!data/history.json
