{
  "name": "asda-meal-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds budget-constrained family meal plans from ASDA's current promotional pricing.",
  "scripts": {
    "snapshot": "bun run src/snapshot.ts",
    "snapshot:diff": "bun run src/snapshot.ts --diff",
    "plan": "bun run src/mealplan.ts",
    "search": "bun run src/ingredients.ts",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "rate": "bun run src/rate.ts",
    "cart": "bun run src/cart.ts",
    "cart:setup": "bun run src/cart.ts --bookmarklet"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
