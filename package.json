{
  "name": "asda-meal-planner",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Builds budget-constrained family meal plans from ASDA's current promotional pricing.",
  "scripts": {
    "snapshot": "bun run src/asda/snapshot.ts",
    "snapshot:diff": "bun run src/asda/snapshot.ts --diff",
    "plan": "bun run src/commands/plan.ts",
    "snacks": "bun run src/commands/snacks.ts",
    "search": "bun run src/planning/ingredients.ts",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "rate": "bun run src/commands/rate.ts",
    "dislike": "bun run src/commands/dislike.ts",
    "cart": "bun run src/commands/cart.ts",
    "cart:setup": "bun run src/commands/cart.ts --bookmarklet"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
